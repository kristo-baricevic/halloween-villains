{
  "name": "halloween-villains",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "halloween-villains",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22.15.0"
      }
    },
    "apps/api": {
      "name": "@halloween/api",
      "version": "1.0.0",
      "dependencies": {
        "@halloween/tournament": "*",
        "@halloween/web": "*"
      }
    },
    "apps/web": {
      "name": "@halloween/web",
      "version": "1.0.0"
    },
    "node_modules/@halloween/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@halloween/tournament": {
      "resolved": "packages/tournament",
      "link": true
    },
    "node_modules/@halloween/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/tournament": {
      "name": "@halloween/tournament",
      "version": "1.0.0"
    }
  }
}
